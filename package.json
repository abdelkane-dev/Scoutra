{
  "name": "scoutra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "pnpm --filter @scoutra/db generate",
    "db:migrate": "pnpm --filter @scoutra/db migrate",
    "dev:web": "pnpm --filter @scoutra/web dev",
    "dev:worker": "pnpm --filter @scoutra/worker dev",
    "license": "pnpm --filter @scoutra/license-cli cli"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@scoutra/db": "workspace:*",
    "@scoutra/queue": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
