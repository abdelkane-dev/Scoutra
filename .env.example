# Modèle de configuration : AUCUNE valeur réelle ici.
# Générer un vrai .env (jamais commité) : scripts/init-secrets.sh [--host localhost] [--url https://…]
# Le démarrage est refusé si un secret manque, est trop court ou ressemble à un exemple.

NODE_ENV=production
# saas | license
SCOUTRA_MODE=saas

# --- Postgres (docker compose) : mots de passe de 24 caractères minimum
POSTGRES_PASSWORD=
SCOUTRA_MIGRATOR_PASSWORD=
SCOUTRA_APP_PASSWORD=
SCOUTRA_AUTH_PASSWORD=

# Rôle applicatif (RLS appliquée, sans BYPASSRLS) : web + worker
DATABASE_URL=
# Rôle Better Auth (tables d'identité uniquement) : web
DATABASE_AUTH_URL=
# Rôle propriétaire : migrations uniquement
DATABASE_MIGRATOR_URL=

# --- Chiffrement (32 octets en base64 : openssl rand -base64 32)
SCOUTRA_MASTER_KEY=
SCOUTRA_MASTER_KEY_VERSION=1
# Pendant une rotation seulement : "version:base64"
SCOUTRA_MASTER_KEY_PREVIOUS=
SCOUTRA_HASH_KEY=

# --- Authentification
BETTER_AUTH_SECRET=
# URL publique de l'application (HTTPS obligatoire en production)
BETTER_AUTH_URL=
SCOUTRA_TRUSTED_ORIGINS=
SCOUTRA_ALLOW_SIGNUP=false
SCOUTRA_REQUIRE_EMAIL_VERIFICATION=true
# 2FA exigée pour les actions sensibles des owners/admins (false : recette uniquement)
SCOUTRA_ENFORCE_ADMIN_2FA=true
# En-tête d'IP client posé (et écrasé) par votre reverse proxy, et IP/CIDR de ce proxy
SCOUTRA_CLIENT_IP_HEADER=x-forwarded-for
SCOUTRA_TRUSTED_PROXIES=
# Connexion Google (optionnelle : les deux ou aucune)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mode licence uniquement
SCOUTRA_LICENSE_TOKEN=
# Clés publiques supplémentaires (recette) : {"kid":"cléBase64url"}
SCOUTRA_LICENSE_PUBLIC_KEYS=

# --- Worker
WORKER_HEALTH_PORT=8081

# --- Tests d'intégration (superutilisateur d'un Postgres local jetable)
TEST_DATABASE_ADMIN_URL=
